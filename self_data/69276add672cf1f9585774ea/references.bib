  file = {/Users/kailaicui/Zotero/storage/3VZEYTQS/Damen et al. - 2022 - Rescaling Egocentric Vision Collection, Pipeline and Challenges for EPIC-KITCHENS-100.pdf}
}

@online{darkhalilEPICKITCHENSVISORBenchmark2022,
  title = {{{EPIC-KITCHENS VISOR Benchmark}}: {{VIdeo Segmentations}} and {{Object Relations}}},
  shorttitle = {{{EPIC-KITCHENS VISOR Benchmark}}},
  author = {Darkhalil, Ahmad and Shan, Dandan and Zhu, Bin and Ma, Jian and Kar, Amlan and Higgins, Richard and Fidler, Sanja and Fouhey, David and Damen, Dima},
  date = {2022-09-26},
  eprint = {2209.13064},
